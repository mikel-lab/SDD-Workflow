{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-workflow.local/operational-state-v1",
  "title": "SDD operational checkpoint v1",
  "description": "Closed typed checkpoint. Runtime additionally verifies current external identity, actual inventories/evidence bytes, canonical event chain, phase/transition prerequisites, nine derived risk gates, ownership, criterion coverage and independent current reviews. Snapshot exclusions control_metadata item references the mandatory scope file and its exact byte hash; it is never an output exclusion. Reviewer replacement requires actual demonstrated unavailability evidence and a full current pending-scope review. Structural validation cannot establish semantic sufficiency or genuine runtime independence.",
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\\\s]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "produced_by": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\\\s]+$"
        },
        "planning_baseline_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "implementation_snapshot_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "kind",
        "produced_by",
        "planning_baseline_id",
        "implementation_snapshot_id"
      ],
      "additionalProperties": false
    },
    "planning": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$"
              },
              "type": {
                "const": "file"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "type",
              "sha256",
              "size"
            ],
            "additionalProperties": false
          }
        },
        "bootstrap": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$"
                },
                "type": {
                  "const": "file"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "path",
                "type",
                "sha256",
                "size"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "inventory",
        "bootstrap"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "base_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "executable": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "sha256",
              "size",
              "executable"
            ],
            "additionalProperties": false
          }
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$"
          },
          "uniqueItems": true
        },
        "deleted_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$"
          },
          "uniqueItems": true
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$"
          },
          "uniqueItems": true
        },
        "exclusions": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$"
                  },
                  "kind": {
                    "enum": [
                      "control",
                      "build",
                      "cache",
                      "temp",
                      "ignored"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "kind",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$"
                  },
                  "kind": {
                    "const": "control_metadata"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "kind",
                  "reason",
                  "sha256"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "file_aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$"
              },
              "link_target": {
                "type": "string",
                "minLength": 1
              },
              "resolved_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$"
              }
            },
            "required": [
              "path",
              "link_target",
              "resolved_path"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "base_revision",
        "inventory",
        "changed_paths",
        "deleted_paths",
        "required_inputs",
        "exclusions"
      ],
      "additionalProperties": false
    },
